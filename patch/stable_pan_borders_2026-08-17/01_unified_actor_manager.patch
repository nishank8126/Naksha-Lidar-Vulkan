def _update_actor_camera_uniforms(actor) -> bool:
    try:
        if actor is None or not actor.GetVisibility():
            return False
        renderer = getattr(actor, '_naksha_renderer', None)
        shader_property = actor.GetShaderProperty()
        if renderer is None or shader_property is None:
            return False
        near_value, far_value = renderer.GetActiveCamera().GetClippingRange()
        if not np.isfinite(near_value) or not np.isfinite(far_value):
            return False
        if far_value - near_value < 1.0e-6:
            return False
        fragment_uniforms = shader_property.GetFragmentCustomUniforms()
        if fragment_uniforms is None:
            return False
        fragment_uniforms.SetUniformf("naksha_near", float(near_value))
        fragment_uniforms.SetUniformf("naksha_far", float(far_value))
        return True
    except (RuntimeError, AttributeError, ReferenceError):
        return False
    except Exception:
        return False


def refresh_widget_camera_uniforms(vtk_widget) -> int:
    if vtk_widget is None:
        return 0
    updated = 0
    try:
        actors = getattr(vtk_widget, "actors", {}) or {}
        for shader_actor in tuple(actors.values()):
            if _update_actor_camera_uniforms(shader_actor):
                updated += 1
    except Exception:
        return updated
    return updated

