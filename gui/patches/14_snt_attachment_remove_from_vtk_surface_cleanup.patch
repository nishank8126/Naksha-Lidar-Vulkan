    def _remove_from_vtk(self, filename: str):
        try:
            target = os.path.basename(str(filename or ""))
            target_lower = target.lower()

            def _norm_name(value) -> str:
                if not value:
                    return ""
                try:
                    return os.path.basename(str(value)).strip().lower()
                except Exception:
                    return str(value).strip().lower()

            def _norm_path(value) -> str:
                if not value:
                    return ""
                try:
                    return str(Path(str(value)).resolve()).strip().lower()
                except Exception:
                    return str(value).strip().lower()

            def _matches_record(record) -> bool:
                if not isinstance(record, dict):
                    return False
                record_name = _norm_name(record.get("filename"))
                record_full = _norm_path(record.get("full_path"))
                return bool(
                    (target_lower and record_name == target_lower)
                    or (target_lower and record_full and os.path.basename(record_full) == target_lower)
                )

            # Collect the layer names that belong to the SNT file being removed,
            # BEFORE its attachment metadata is dropped below. Used to also take
            # this file's committed on-screen drawings off the canvas.
            removed_layers = set()
            try:
                for a in getattr(self.app, "snt_attachments", []) or []:
                    if _matches_record(a):
                        parsed = a.get("parsed") or {}
                        for l in parsed.get("layers", []) or []:
                            nm = l.get("name")
                            if nm:
                                removed_layers.add(str(nm))
            except Exception:
                pass

            renderer = None
            try:
                if (
                    hasattr(self.app, "vtk_widget")
                    and self.app.vtk_widget is not None
                    and hasattr(self.app.vtk_widget, "renderer")
                ):
                    renderer = self.app.vtk_widget.renderer
            except Exception:
                renderer = None

            extra_renderers = []
            try:
                digitizer = getattr(self.app, "digitizer", None)
                for extra in (
                    getattr(digitizer, "overlay_renderer", None),
                    getattr(digitizer, "text_overlay_renderer", None),
                ):
                    if extra is not None and extra is not renderer and extra not in extra_renderers:
                        extra_renderers.append(extra)
            except Exception:
                pass

            removed_actor_ids = set()

