            # 1) Remove real SNT/DXF actors matching the removed SNT filename
            for store_name in ["snt_actors", "dxf_actors"]:
                if not hasattr(self.app, store_name):
                    continue

                store = getattr(self.app, store_name, [])
                indices_to_remove = []

                for i, snt_data in enumerate(store):
                    if _matches_record(snt_data):
                        indices_to_remove.append(i)

                        for actor in snt_data.get("actors", []):
                            try:
                                if actor is not None:
                                    removed_actor_ids.add(id(actor))
                                    if renderer is not None:
                                        renderer.RemoveActor(actor)
                            except Exception:
                                pass

                for i in reversed(indices_to_remove):
                    try:
                        store.pop(i)
                    except IndexError:
                        pass

            # 1b) Sweep the live renderer for any tagged SNT actors that escaped
            # the actor stores above. This is the final guard against stale
            # geometry remaining visible after the popup row has been removed.
            all_renderers = [r for r in [renderer] + extra_renderers if r is not None]
            if all_renderers:
                try:
                    doomed = []

                    def _collect_matching_props(vtk_renderer, getter_name: str):
                        try:
                            collection = getattr(vtk_renderer, getter_name)()
                            collection.InitTraversal()
                            while True:
                                getter = getattr(
                                    collection,
                                    "GetNextActor2D" if getter_name == "GetActors2D" else "GetNextActor",
                                )
                                actor = getter()
                                if actor is None:
                                    break
                                actor_name = _norm_name(getattr(actor, "_naksha_snt_filename", ""))
                                if id(actor) in removed_actor_ids or (target_lower and actor_name == target_lower):
                                    doomed.append((vtk_renderer, actor))
                        except Exception:
                            pass

                    for vtk_renderer in all_renderers:
                        _collect_matching_props(vtk_renderer, "GetActors")
                        _collect_matching_props(vtk_renderer, "GetActors2D")

                    seen_pairs = set()
                    for vtk_renderer, actor in doomed:
                        pair_key = (id(vtk_renderer), id(actor))
                        if pair_key in seen_pairs:
                            continue
                        seen_pairs.add(pair_key)
                        try:
                            vtk_renderer.RemoveActor(actor)
                        except Exception:
                            pass
                        try:
                            vtk_renderer.RemoveActor2D(actor)
                        except Exception:
                            pass
                        try:
                            vtk_renderer.RemoveViewProp(actor)
                        except Exception:
                            pass
                except Exception as exc:
                    print(f"  [warn] renderer sweep after SNT remove failed: {exc}")

            # Remove tagged SNT props from overlay renderers even when they are not
            # present in GetActors()/GetActors2D() anymore but still registered as
            # generic view props after Surface-mode promotion.
            for vtk_renderer in extra_renderers:
                try:
                    props = vtk_renderer.GetViewProps()
                    props.InitTraversal()
                    while True:
                        actor = props.GetNextProp()
                        if actor is None:
                            break
                        actor_name = _norm_name(getattr(actor, "_naksha_snt_filename", ""))
                        if id(actor) in removed_actor_ids or (target_lower and actor_name == target_lower):
                            try:
                                vtk_renderer.RemoveViewProp(actor)
                            except Exception:
                                pass
                except Exception as exc:
                    print(f"  [warn] overlay view-prop sweep after SNT remove failed: {exc}")

