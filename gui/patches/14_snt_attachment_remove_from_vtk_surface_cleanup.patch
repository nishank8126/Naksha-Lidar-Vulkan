            try:
                active_file = _norm_name(getattr(self.app, "active_snt_filename", ""))
                if target_lower and active_file == target_lower:
                    self.app.active_snt_layer = None
                    self.app.active_snt_filename = None
                    self.app.active_snt_color = None
            except Exception:
                pass

            # 6) Invalidate vector/unified caches so later refreshes cannot
